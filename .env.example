PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/clientflow
PUBLIC_API_URL=http://localhost:4000

# local (default) | s3 | cloudinary
STORAGE_DRIVER=local

# S3 (used when STORAGE_DRIVER=s3 or S3_BUCKET is set)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Cloudinary (used when STORAGE_DRIVER=cloudinary or CLOUDINARY_CLOUD_NAME is set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
